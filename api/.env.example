# Database (SQLite for local dev, Supabase PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OTP (Africa's Talking)
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID="Klokd"

# M-Pesa Daraja
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""
DARAJA_SHORTCODE=""
DARAJA_B2C_SECURITY_CREDENTIAL=""
DARAJA_ENV="sandbox"

# Supabase (storage + production database)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="klokd-documents"

# Expo Push Notifications
EXPO_PUSH_TOKEN=""

# App
PORT=3000
NODE_ENV="development"
GPS_CLOCK_IN_RADIUS_METERS=500
ESCROW_AUTO_RELEASE_HOURS=4
