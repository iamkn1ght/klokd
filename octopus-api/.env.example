# Klokd v3 — Environment variables (per Klokd v3 Rails Integration Advisory v1.0)
# Cardinal rule: Klokd never holds Daraja, Africa's Talking, or WhatsApp credentials.
# All such concerns flow through KMV platform rails.

# ─── Core ───────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
AWS_REGION="eu-west-1"

# Database (SQLite local · Supabase Postgres production)
DATABASE_URL="file:./dev.db"

# JWT (Klokd-issued; orthogonal to Identiti step-up JWTs)
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── KMV Platform Rails ─────────────────────────────────
# All four sets must come from Silvia Mumbua (CTO, Kipkiren Teknolojia).

# Identiti (AD-K02, AD-K10) — account UUID, KYC, phone tokens, step-up
IDENTITI_BASE_URL=""
IDENTITI_API_KEY=""
IDENTITI_WEBHOOK_SECRET=""

# Todoku (AD-K03) — SMS, OTP, WhatsApp
# Klokd is registered as external billed tenant.
TODOKU_BASE_URL=""
TODOKU_API_KEY=""
TODOKU_TENANT_ID="klokd"
TODOKU_WEBHOOK_SECRET=""

# Payment Rail (AD-K01, AD-K06, AD-K07)
# Phase 1: https://sandbox.pay.kipkiren.co.ke · Phase 3: https://api.lipastack.co.ke
# NEVER name this variable KIPKIREN_PAY_BASE_URL — the name does not survive Phase 3.
PAYMENT_RAIL_BASE_URL=""
PAYMENT_RAIL_API_KEY=""
PAYMENT_RAIL_WEBHOOK_SECRET=""

# Hakken (AD-K09) — Phase 1: register entities · Phase 3: query for discovery
HAKKEN_BASE_URL=""
HAKKEN_API_KEY=""

# ─── Klokd-Owned Infrastructure ─────────────────────────

# Supabase (AD-K04) — pay statements + contracts only, NOT identity documents
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="klokd-documents"

# Expo Push / FCM (AD-K05) — direct integration; Todoku does not handle push
EXPO_PUSH_TOKEN=""

# ─── Platform Tuning ────────────────────────────────────
GPS_CLOCK_IN_RADIUS_METERS=500
ESCROW_AUTO_RELEASE_HOURS=4
PAYOUT_STEP_UP_THRESHOLD_KES=20000

# ─── DO NOT SET (cardinal rule violations) ──────────────
# DARAJA_*           → lives in Kipkiren Pay, not Klokd
# AT_API_KEY         → lives in Todoku, not Klokd
# WHATSAPP_API_TOKEN → lives in Todoku, not Klokd
