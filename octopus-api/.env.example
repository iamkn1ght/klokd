# Klokd v3 — Environment variables (per Klokd v3 Rails Integration Advisory v1.0)
# Cardinal rule: Klokd never holds Daraja, Africa's Talking, or WhatsApp credentials.
# All such concerns flow through KMV platform rails.

# ─── Core ───────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
AWS_REGION="eu-west-1"

# Database (SQLite local · Supabase Postgres production)
DATABASE_URL="file:./dev.db"

# JWT (Klokd-issued; orthogonal to Identiti step-up JWTs)
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── KMV Platform Rails ─────────────────────────────────
# All four sets must come from Silvia Mumbua (CTO, Kipkiren Teknolojia).

# Identiti (AD-K02, AD-K10) — account UUID, KYC, phone tokens, step-up
# Per-request HMAC-SHA256 signing. Signature encoding is BASE64 (operator §4
# says hex; live rail expects base64 — verified 2026-06-09).
# APP_SECRET must be hex-64. Webhook secret deferred (Kafka today; HTTP webhook
# signing ships in ID-14 Phase 2).
IDENTITI_API_BASE="https://identiti-production.up.railway.app"
IDENTITI_APP_ID="klokd_sandbox"
IDENTITI_APP_SECRET=""
IDENTITI_WEBHOOK_SECRET=""

# Todoku (AD-K03) — SMS, OTP, WhatsApp
# Per-request HMAC-SHA256 signing, base64 signature output.
# APP_SECRET is base64url-43 (no padding); WEBHOOK_SECRET same encoding.
# OTP delivery goes through POST /v1/messages/send with the OTP template ULID
# (NOT a separate /v1/otp/send endpoint).
TODOKU_API_BASE="https://todoku-prod-production.up.railway.app"
TODOKU_APP_ID="klokd_sandbox"
TODOKU_APP_SECRET=""
TODOKU_WEBHOOK_SECRET=""

# Payment Rail (AD-K01, AD-K06, AD-K07)
# Phase 1: Kipkiren Pay sandbox (URL pending Railway deploy — KP-1-Ops)
# Phase 3: LipaStack — flip PAYMENT_RAIL_API_BASE only, no code change.
# NEVER name this variable KIPKIREN_PAY_* — the name does not survive Phase 3.
# APP_SECRET is base64url-43 (no padding). WEBHOOK_SECRET conditional:
# only required if your app picks fork-2 (KP HTTP webhook signer) instead of
# fork-1 (Kafka consumer) or fork-3 (poll). See KMV_RAILS_INTEGRATION_GUIDE.md §6.
PAYMENT_RAIL_API_BASE=""
PAYMENT_RAIL_APP_ID="klokd_sandbox"
PAYMENT_RAIL_APP_SECRET=""
PAYMENT_RAIL_WEBHOOK_SECRET=""

# Hakken (AD-K09) — Phase 1: register entities · Phase 3: query for discovery
HAKKEN_BASE_URL=""
HAKKEN_API_KEY=""

# Helpan AI — agent runtime rail (per KMV_RAILS_INTEGRATION_GUIDE.md §7)
# App ID is LITERAL "klokd" (NOT klokd_sandbox — Helpan keys on app slug).
# APP_SECRET is hex-64; WEBHOOK_SECRET hex-64. Webhook canonical is different
# from request canonical: {TIMESTAMP}\n{PATH}\n{SHA256_HEX(body)} — no method,
# no content type. Operator must register HELPAN_WEBHOOK_URL_KLOKD on their side.
HELPAN_API_BASE=""
HELPAN_APP_ID="klokd"
HELPAN_APP_SECRET=""
HELPAN_WEBHOOK_SECRET=""

# ─── Klokd-Owned Infrastructure ─────────────────────────

# Supabase (AD-K04) — pay statements + contracts only, NOT identity documents
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="klokd-documents"

# Expo Push / FCM (AD-K05) — direct integration; Todoku does not handle push
EXPO_PUSH_TOKEN=""

# ─── Platform Tuning ────────────────────────────────────
GPS_CLOCK_IN_RADIUS_METERS=500
ESCROW_AUTO_RELEASE_HOURS=4
PAYOUT_STEP_UP_THRESHOLD_KES=20000

# ─── DO NOT SET (cardinal rule violations) ──────────────
# DARAJA_*           → lives in Kipkiren Pay, not Klokd
# AT_API_KEY         → lives in Todoku, not Klokd
# WHATSAPP_API_TOKEN → lives in Todoku, not Klokd
