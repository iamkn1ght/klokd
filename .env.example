# ============================================================
# Klokd v3 — Environment Variables (Octopus API)
# Copy to octopus-api/.env and fill in. Never commit .env.
# ============================================================
# Authority: chamia new docs/klokd_sprint_backlog_delta_silvia_v1.1.md Part F
# Pattern: PAYMENT_RAIL_* (NOT KIPKIREN_PAY_*) per AD-K06.
# Anti-pattern: DARAJA_* / AFRICASTALKING_* / WHATSAPP_* — NONE belong in
#   Klokd's env. They live in Kipkiren Pay (Daraja) and Todoku (AT, WA).

# ============================================================
# App
# ============================================================
PORT=3000
NODE_ENV=development                      # development | staging | production
LOG_LEVEL=info

# ============================================================
# Database — Supabase Postgres
# Region per delta Part F: eu-west-1. Default unless Chamia overrides
# (reboot pack v1.0 §3 says af-south-1 — predates Reboot Pack v1.3 §13.4).
# ============================================================
DATABASE_URL=                            # Supabase Postgres URL (port 6543 pgbouncer)
SUPABASE_URL=                            # https://<project>.supabase.co
SUPABASE_SERVICE_KEY=                    # Service role — never expose to clients
SUPABASE_ANON_KEY=                       # Anon — JWT verification only

# ============================================================
# Klokd internal JWT (after Identiti account active confirmed)
# ============================================================
JWT_SECRET=                              # Strong random — 32+ bytes
JWT_REFRESH_SECRET=                      # Different from JWT_SECRET
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# KMV Rails — consuming-app credentials
# Activated by env-var presence at boot. Mixed-config rejected.
# All-empty per rail = rail inactive (legacy direct-vendor still works
# for that rail until migration sprint completes).
# ============================================================

# --- Identiti (S3-NEW-01) ---
# Operator request: OPERATOR_REQUEST_IDENTITI.md
# Wire format: per-request HMAC (NOT token-exchange) per Lunch Drop
#   integrator handover (commit b8b3279 on whyyam1/identiti).
# Secret encoding: HEX HMAC-SHA-256 (64 chars).
# Webhook secret DEFERRED until ID-14 Phase 2.
IDENTITI_BASE_URL=                       # sandbox first; eu-west-1 prod when wired
IDENTITI_APP_ID=klokd_sandbox            # tenant slug
IDENTITI_APP_SECRET=                     # HEX HMAC-SHA-256 (64 chars); from 1Password
# Optional override:
# IDENTITI_JWKS_URL_OVERRIDE=https://sandbox.id.identiti.co.ke/.well-known/jwks.json

# --- Payment Rail (S3-NEW-03 + S16 C4) ---
# Operator request: OPERATOR_REQUEST_KP.md
# CRITICAL naming: PAYMENT_RAIL_* (NOT KIPKIREN_PAY_*) per AD-K06.
# Phase 1: Kipkiren Pay sandbox.
# Phase 3: LipaStack production. Env-var flip only — no code change.
# Secret encoding: HEX (64 chars).
# Corporate account UUID for B2C payouts is a code constant — see
#   operator request §2.2.
PAYMENT_RAIL_BASE_URL=                   # Phase 1: https://sandbox.pay.kipkiren.co.ke/v1
                                         # Phase 3: https://api.lipastack.co.ke
PAYMENT_RAIL_APP_ID=
PAYMENT_RAIL_APP_SECRET=                 # HEX HMAC-SHA-256 (64 chars)
PAYMENT_RAIL_WEBHOOK_SECRET=             # HEX HMAC-SHA-256 (64 chars) — webhooks
# Optional override (replace placeholder zeros before LD-16 / Sprint 16):
# PAYMENT_RAIL_CORPORATE_ACCOUNT_UUID=

# --- Todoku (S3-NEW-02 + S9-NEW-01) ---
# Operator request: OPERATOR_REQUEST_TODOKU.md
# Tenant: klokd · EXTERNAL BILLED (not bypass-billing) — per advisory §2.3
# Secret encoding: BASE64 (44 chars) — distinct from Identiti+KP hex per
#   Todoku CONTRACT.md.
# NOTE: 6 core templates + 2 Health templates (8 total) must be
#   submitted + approved. WhatsApp templates need Meta approval (24–72h).
TODOKU_BASE_URL=                         # e.g. https://todoku-prod-production.up.railway.app/v1
TODOKU_APP_ID=                           # klokd tenant UUID from 1Password
TODOKU_APP_SECRET=                       # BASE64 HMAC-SHA-256 (44 chars) — NOT hex
TODOKU_WEBHOOK_SECRET=                   # BASE64 (44 chars) — webhooks
TODOKU_TENANT_ID=klokd                   # external billed tenant slug

# --- Hakken (S5-NEW-01 + S8-NEW-01) ---
# Operator request: OPERATOR_REQUEST_HAKKEN.md
# Phase 3 (Sprint 8+) for discovery backing. Entity registration starts
#   at Sprint 5 (non-blocking; if Hakken down, shift still posts).
HAKKEN_BASE_URL=                         # sandbox first; prod when wired
HAKKEN_APP_ID=klokd
HAKKEN_APP_SECRET=                       # HEX or per Hakken contract

# --- Helpan AI (Phase 2 — NOT in Klokd v3 MVP) ---
# DEFERRED. helpan-klokd-v1 agent already admitted at H-9 (closed 21 May)
# but no Klokd-specific agent at v3 MVP per advisory §2.5.
# HELPAN_BASE_URL=
# HELPAN_APP_ID=
# HELPAN_APP_SECRET=

# ============================================================
# Klokd-owned infrastructure (UNCHANGED — legitimate Klokd functions)
# ============================================================

# Klokd S3 — pay statements + contracts ONLY (NOT KYC docs per AD-K02)
SUPABASE_STORAGE_BUCKET=klokd-documents  # retained for pay statements + contracts

# Firebase FCM — direct integration (Todoku doesn't handle push per AD-K05)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                    # JSON-escaped private key

# Sentry
SENTRY_DSN=

# ============================================================
# ⚠️ ANTI-PATTERN — the following MUST NOT exist in Klokd env
# ============================================================
# DARAJA_CONSUMER_KEY                    → lives in Kipkiren Pay, not Klokd
# DARAJA_CONSUMER_SECRET                 → lives in Kipkiren Pay, not Klokd
# DARAJA_PASSKEY                         → lives in Kipkiren Pay, not Klokd
# DARAJA_SHORTCODE                       → lives in Kipkiren Pay, not Klokd
# DARAJA_B2C_SECURITY_CREDENTIAL         → lives in Kipkiren Pay, not Klokd
# AFRICASTALKING_API_KEY  (AT_API_KEY)   → lives in Todoku, not Klokd
# AFRICASTALKING_USERNAME (AT_USERNAME)  → lives in Todoku, not Klokd
# WHATSAPP_API_TOKEN                     → lives in Todoku, not Klokd

# ============================================================
# Deploy
# ============================================================
RAILWAY_ENVIRONMENT=development
SERVICE_NAME=klokd-octopus-api           # for structured logs + traceparent
