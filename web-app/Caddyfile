{
	admin off
	auto_https off
}

# Security headers, on every response including error pages.
# CSP: the app is one bundle from /_expo (no inline or eval'd script);
# react-native-web writes inline styles; the only other origin it talks to is
# the API (API_ORIGIN, set on Railway if the API moves). JSON-LD blocks are
# data, not script, so script-src 'self' holds.
(security) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' {$API_ORIGIN:https://octopus-api-production.up.railway.app}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	import security

	@www host www.klokd.co.ke
	redir @www https://klokd.co.ke{uri} permanent

	handle /healthz {
		respond 200
	}

	# Hashed bundles never change; the HTML pages must always be fresh.
	header /_expo/* Cache-Control "public, max-age=31536000, immutable"
	@pages path / /index.html /terms* /privacy* /workers* /businesses* /pricing* /guides* /llms.txt
	header @pages Cache-Control "no-cache"

	handle {
		# Real files and the prerendered folders (/terms, /privacy). The app
		# routes by hash (#/worker/…), so no other path needs the app shell:
		# anything else is a real 404, not a 200 copy of the home page.
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		import security
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
}
