{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	@www host www.klokd.co.ke
	redir @www https://klokd.co.ke{uri} permanent

	handle /healthz {
		respond 200
	}

	# Hashed bundles never change; index.html must always be fresh.
	header /_expo/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
