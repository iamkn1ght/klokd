{
  "expo": {
    "name": "Klokd",
    "slug": "klokd-worker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "klokd",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.ke.klokd.worker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.ke.klokd.worker",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Klokd uses your location to verify you are at the work venue when you clock in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Klokd needs access to your photos to upload your ID and selfie for verification."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#00E5A0"
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ]
    ],
    "owner": "mumbus",
    "extra": {
      "eas": {
        "projectId": "b0ad4125-58c3-4f80-9fee-b18462e0f3ee"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b0ad4125-58c3-4f80-9fee-b18462e0f3ee"
    }
  }
}
